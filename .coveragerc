[run]
source = core,config,server
branch = True
omit =
    */tests/*
    */migrations/*
    */.venv/*
    */Docker/*
    */instance/*
    */static/*
    */__pycache__/*
    */prompts/*

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    ^\s*pass\s*$
    if __name__ == .__main__.:

[html]
directory = htmlcov
title = IAM Gateway — Test Coverage Report
